import AiryIdeals.TwistedModule

/-!
# Constructing Airy ideals (Section 2.6) and examples

* `rees_comm` (**eq. (2.5)**): `[𝒟̂_A^ħ, 𝒟̂_A^ħ] ⊆ ħ² 𝒟̂_A^ħ`.
* `comm_mem_of_gens`: to check condition (4), `[I, I] ⊆ ħ² I`, it suffices to check
  `[Hᵢ, Hⱼ] ∈ ħ² I` on generators (the remark before Lemma 2.25).
* `StablePotential.isAiryIdeal` (**Lemmas 2.23 and 2.24**): every `φ_S(I_can)` is an Airy ideal.
  With Theorem 2.17 this gives `isAiryIdeal_iff`: *a left ideal is Airy iff it is the image of
  `I_can` under a stable transvection.*
* `isAiryIdeal_of_matrix` (**Lemma 2.25**, finite `A`): generators `Hᵢ = ∑ₐ Mᵢₐ ħ∂ₐ + O(ħ²)`
  related to normal-form ones by an invertible matrix also generate an Airy ideal.
* `not_isAiryIdeal_example` (Remark after Definition 2.16): the ideal generated by `ħ∂₁` and
  `ħ∂₂ + ħ²x₁` satisfies conditions (1)–(3) but not (4).
-/

open PowerSeries Finset

namespace AiryIdeals

set_option linter.unusedSectionVars false

variable {σ K : Type*} [Fintype σ] [Field K] [CharZero K]

/-! ### `[𝒟̂, 𝒟̂] ⊆ ħ² 𝒟̂` -/

/-- **Eq. (2.5).** Commutators in `𝒟̂_A^ħ` are divisible by `ħ²`. -/
theorem rees_comm (P Q : ReesWeyl σ K) : ∃ T : ReesWeyl σ K, P * Q - Q * P = hbar ^ 2 * T := by
  set D : OpSeries σ K := (P : OpSeries σ K) * Q - Q * P with hD
  have hcoeff : ∀ n, coeff n D = ∑ p ∈ antidiagonal n,
      (coeff p.1 (P : OpSeries σ K) * coeff p.2 (Q : OpSeries σ K) -
        coeff p.2 (Q : OpSeries σ K) * coeff p.1 (P : OpSeries σ K)) := fun n => by
    rw [hD, map_sub, coeff_mul, coeff_mul, sum_sub_distrib,
      ← Finset.Nat.sum_antidiagonal_swap (f := fun p => coeff p.1 (Q : OpSeries σ K) *
        coeff p.2 (P : OpSeries σ K))]
    rfl
  have hterm : ∀ i j, coeff i (P : OpSeries σ K) * coeff j (Q : OpSeries σ K) -
      coeff j (Q : OpSeries σ K) * coeff i (P : OpSeries σ K) ∈ bernstein σ K (i + j - 2) := by
    intro i j
    rcases i with _ | i
    · rw [bernstein_zero_comm (P.2 0), sub_self]; exact zero_mem _
    rcases j with _ | j
    · rw [bernstein_zero_comm (Q.2 0), sub_self]; exact zero_mem _
    rw [show i + 1 + (j + 1) - 2 = i + j by omega]
    exact bernstein_comm_mem (P.2 _) (Q.2 _)
  have hsmall : ∀ n < 2, coeff n D = 0 := by
    intro n hn
    rw [hcoeff]
    refine sum_eq_zero fun p hp => ?_
    rw [HasAntidiagonal.mem_antidiagonal] at hp
    rcases p with ⟨_ | i, j⟩
    · rw [bernstein_zero_comm (P.2 0), sub_self]
    · have hj : j = 0 := by simp at hp; omega
      subst hj
      rw [bernstein_zero_comm (Q.2 0), sub_self]
  obtain ⟨T, hT⟩ := X_pow_dvd_iff.mpr hsmall
  refine ⟨⟨T, fun k => ?_⟩, Subtype.ext ?_⟩
  · have : coeff (k + 2) D = coeff k T := by
      rw [hT, coeff_X_pow_mul', if_pos (by omega), Nat.add_sub_cancel]
    rw [← this, hcoeff]
    refine Submodule.sum_mem _ fun p hp => ?_
    rw [HasAntidiagonal.mem_antidiagonal] at hp
    have := hterm p.1 p.2
    rwa [hp, Nat.add_sub_cancel] at this
  · simpa [hD] using hT

/-! ### Checking condition (4) on generators -/

/-- The left ideal `ħ² I`. -/
def hbarSqIdeal (I : LeftIdeal σ K) : LeftIdeal σ K where
  carrier := {x | ∃ T ∈ I, x = hbar ^ 2 * T}
  zero_mem' := ⟨0, zero_mem _, by simp⟩
  add_mem' := by
    rintro _ _ ⟨T, hT, rfl⟩ ⟨T', hT', rfl⟩
    exact ⟨T + T', add_mem hT hT', by rw [mul_add]⟩
  smul_mem' := by
    rintro P _ ⟨T, hT, rfl⟩
    refine ⟨P * T, Submodule.smul_mem _ P hT, ?_⟩
    rw [smul_eq_mul, ← mul_assoc, ← mul_assoc, pow_two, ← mul_assoc,
      ← hbar_mul_comm P, mul_assoc hbar P, ← hbar_mul_comm P, ← mul_assoc]

lemma comm_mul_mem_hbarSqIdeal (I : LeftIdeal σ K) (P Q : ReesWeyl σ K) {Y : ReesWeyl σ K}
    (hY : Y ∈ I) : (P * Q - Q * P) * Y ∈ hbarSqIdeal I := by
  obtain ⟨T, hT⟩ := rees_comm P Q
  exact ⟨T * Y, Submodule.smul_mem _ T hY, by rw [hT, mul_assoc]⟩

/-- To check `[I, I] ⊆ ħ² I` it suffices to check `[Hᵢ, Hⱼ] ∈ ħ² I` on generators. -/
theorem comm_mem_of_gens {ι : Type*} [Fintype ι] (H : ι → ReesWeyl σ K)
    (hH : ∀ i j, ∃ T ∈ Submodule.span (ReesWeyl σ K) (Set.range H),
      H i * H j - H j * H i = hbar ^ 2 * T) :
    ∀ P ∈ Submodule.span (ReesWeyl σ K) (Set.range H),
      ∀ Q ∈ Submodule.span (ReesWeyl σ K) (Set.range H),
        ∃ T ∈ Submodule.span (ReesWeyl σ K) (Set.range H), P * Q - Q * P = hbar ^ 2 * T := by
  set I := Submodule.span (ReesWeyl σ K) (Set.range H)
  have hHI : ∀ i, H i ∈ I := fun i => Submodule.subset_span ⟨i, rfl⟩
  have spanSum : ∀ {P}, P ∈ I → ∃ c : ι → ReesWeyl σ K, P = ∑ i, c i * H i := fun hP => by
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hP
    exact ⟨c, by rw [← hc]; rfl⟩
  -- step 1: `[Hᵢ, Q] ∈ ħ² I`
  have step1 : ∀ i, ∀ Q ∈ I, H i * Q - Q * H i ∈ hbarSqIdeal I := by
    intro i Q hQ
    obtain ⟨d, rfl⟩ := spanSum hQ
    have : H i * ∑ j, d j * H j - (∑ j, d j * H j) * H i =
        ∑ j, (d j * (H i * H j - H j * H i) + (H i * d j - d j * H i) * H j) := by
      simp only [mul_sum, sum_mul, ← sum_sub_distrib]
      exact sum_congr rfl fun j _ => by simp only [mul_sub, sub_mul, mul_assoc]; abel
    rw [this]
    refine sum_mem fun j _ => add_mem ?_ (comm_mul_mem_hbarSqIdeal I _ _ (hHI j))
    obtain ⟨T, hT, hTeq⟩ := hH i j
    rw [hTeq]
    exact (hbarSqIdeal I).smul_mem (d j) ⟨T, hT, rfl⟩
  -- step 2: `[P, Q] ∈ ħ² I`
  intro P hP Q hQ
  obtain ⟨c, rfl⟩ := spanSum hP
  have : (∑ i, c i * H i) * Q - Q * ∑ i, c i * H i =
      ∑ i, (c i * (H i * Q - Q * H i) + (c i * Q - Q * c i) * H i) := by
    simp only [mul_sum, sum_mul, ← sum_sub_distrib]
    exact sum_congr rfl fun i _ => by simp only [mul_sub, sub_mul, mul_assoc]; abel
  rw [this]
  exact sum_mem fun i _ => add_mem ((hbarSqIdeal I).smul_mem _ (step1 i Q hQ))
    (comm_mul_mem_hbarSqIdeal I _ _ (hHI i))

/-! ### Every `φ_S(I_can)` is Airy -/

namespace StablePotential

variable (S : StablePotential σ K)

lemma curlDiv_dPot (a b : σ) : curlDiv S.dPot a b = 0 := by
  have : curl S.dPot a b = 0 := by
    simp only [curl, dPot, dSer_X_mul, dSer_comm a b, sub_self]
  refine PowerSeries.ext fun n => ?_
  rw [curlDiv, coeff_mk, this, map_zero, map_zero]

/-- The `H̄ₐ` commute. -/
lemma barH_comm (a b : σ) : S.barH a * S.barH b - S.barH b * S.barH a = 0 := by
  rw [barH, barH, barOp_comm S.dPot S.dPot_coeff]
  have : polyOp ⟨curlDiv S.dPot a b, curlDiv_mem S.dPot S.dPot_coeff a b⟩ = 0 := by
    apply Subtype.ext
    simp [polyOp, curlDiv_dPot]
  rw [this, mul_zero]

/-- **Lemmas 2.23 / 2.24.** For every stable potential `S`, `φ_S(I_can)` is an Airy ideal. -/
theorem isAiryIdeal : IsAiryIdeal S.ideal where
  exists_gens := ⟨S.barH, rfl, fun a => by
    have : S.barH a - hd a = polyOp (S.dPot a) := by rw [barH, barOp]; abel
    rw [this]
    refine ⟨?_, ?_⟩ <;> simp [polyOp, coeff_map, (S.dPot_coeff a).1, (S.dPot_coeff a).2]⟩
  comm_mem := comm_mem_of_gens S.barH fun a b => ⟨0, zero_mem _, by rw [barH_comm, mul_zero]⟩

end StablePotential

/-- **Airy ideals are exactly the images of `I_can` under stable transvections.**
(Theorem 2.17 together with Lemma 2.24.) -/
theorem isAiryIdeal_iff (I : LeftIdeal σ K) : IsAiryIdeal I ↔ ∃ S : StablePotential σ K, I = S.ideal :=
  ⟨fun hI => hI.exists_potential, fun ⟨S, hS⟩ => hS ▸ S.isAiryIdeal⟩

/-! ### Lemma 2.25: change of generators -/

/-- The `ħᵏ` coefficient, as a `K`-linear map on `𝒟̂_A^ħ`. -/
noncomputable def reesCoeff (k : ℕ) : ReesWeyl σ K →ₗ[K] Op σ K where
  toFun P := coeff k (P : OpSeries σ K)
  map_add' P Q := by simp
  map_smul' r P := by
    simp only [Algebra.smul_def, RingHom.id_apply]
    rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, PowerSeries.algebraMap_apply, coeff_C_mul]

lemma reesCoeff_apply (k : ℕ) (P : ReesWeyl σ K) :
    reesCoeff k P = coeff k (P : OpSeries σ K) := rfl

/-- **Lemma 2.25** (finite index sets). Let `Hᵢ = ∑ₐ Mᵢₐ ħ∂ₐ + O(ħ²)`, with `M` an invertible
matrix (`N M = 1`, `M N = 1`), and `[Hᵢ, Hⱼ] ∈ ħ² ⟨H⟩`. Then `⟨H⟩` is an Airy ideal. It is
generated by `H̃ₐ = ∑ᵢ Nₐᵢ Hᵢ = ħ∂ₐ + O(ħ²)`. -/
theorem isAiryIdeal_of_matrix {ι : Type*} [Fintype ι] [DecidableEq ι] [DecidableEq σ]
    (H : ι → ReesWeyl σ K) (M : Matrix ι σ K) (N : Matrix σ ι K)
    (hNM : N * M = 1) (hMN : M * N = 1)
    (hH : ∀ i, IsBigOHbarSq (H i - ∑ a, M i a • hd a))
    (hcomm : ∀ i j, ∃ T ∈ Submodule.span (ReesWeyl σ K) (Set.range H),
      H i * H j - H j * H i = hbar ^ 2 * T) :
    IsAiryIdeal (Submodule.span (ReesWeyl σ K) (Set.range H)) := by
  set Ht : σ → ReesWeyl σ K := fun a => ∑ i, N a i • H i
  have hsmul_mem : ∀ (J : LeftIdeal σ K) (r : K) {x}, x ∈ J → r • x ∈ J := fun J r x hx => by
    rw [Algebra.smul_def]; exact J.smul_mem _ hx
  have hspan : Submodule.span (ReesWeyl σ K) (Set.range H) =
      Submodule.span (ReesWeyl σ K) (Set.range Ht) := by
    refine le_antisymm (Submodule.span_le.mpr ?_) (Submodule.span_le.mpr ?_)
    · rintro _ ⟨i, rfl⟩
      have : H i = ∑ a, M i a • Ht a := by
        simp only [Ht, smul_sum, smul_smul, sum_comm (s := univ) (t := univ)
          (f := fun a j => (M i a * N a j) • H j), ← sum_smul]
        simp only [← Matrix.mul_apply, hMN, Matrix.one_apply, ite_smul, one_smul, zero_smul,
          sum_ite_eq, mem_univ, if_true]
      rw [this]
      exact sum_mem fun a _ => hsmul_mem _ _ (Submodule.subset_span ⟨a, rfl⟩)
    · rintro _ ⟨a, rfl⟩
      exact sum_mem fun i _ => hsmul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  refine ⟨⟨Ht, hspan, fun a => ?_⟩, comm_mem_of_gens H hcomm⟩
  have key : ∀ k < 2, reesCoeff k (Ht a - hd a) = 0 := by
    intro k hk
    have hHk : ∀ i, reesCoeff k (H i) = ∑ b, M i b • reesCoeff k (hd b) := fun i => by
      have h := hH i
      have : reesCoeff k (H i - ∑ b, M i b • hd b) = 0 := by
        interval_cases k
        · exact h.1
        · exact h.2
      rw [map_sub, sub_eq_zero, map_sum] at this
      simpa [map_smul] using this
    simp only [Ht, map_sub, map_sum, map_smul, hHk, smul_sum, smul_smul]
    rw [sum_comm]
    simp only [← sum_smul, ← Matrix.mul_apply, hNM, Matrix.one_apply, ite_smul, one_smul,
      zero_smul, sum_ite_eq, mem_univ, if_true, sub_self]
  exact ⟨key 0 (by norm_num), key 1 (by norm_num)⟩

/-! ### A non-example (Remark after Definition 2.16) -/

section Example

variable (K)

/-- `H₁ = ħ∂₁`, `H₂ = ħ∂₂ + ħ²x₁` (variables indexed by `Fin 2`). -/
noncomputable def exH : Fin 2 → ReesWeyl (Fin 2) K := ![hd 0, hd 1 + hbar * hx 0]

lemma exH_zero : exH K 0 = hd 0 := rfl
lemma exH_one : exH K 1 = hd 1 + hbar * hx 0 := rfl

lemma hx_smul (a : σ) (f : PolySeries σ K) :
    (hx a : ReesWeyl σ K) • f = X * (C (MvPolynomial.X a) * f) := by
  rw [rees_smul_def]
  have hC : (C (xOp a) : OpSeries σ K) =
      PowerSeries.map mulOp.toRingHom (C (MvPolynomial.X a)) := by rw [map_C]; rfl
  simp only [coe_hx]
  rw [(commute_X _).eq, act_X_mul, hC, act_map_mulOp]

lemma dSer_C_X (a b : σ) [DecidableEq σ] :
    dSer a (C (MvPolynomial.X b) : PolySeries σ K) = if a = b then 1 else 0 := by
  rw [dSer_C, MvPolynomial.pderiv_X]
  by_cases h : a = b
  · subst h; simp
  · simp [Pi.single_apply, Ne.symm h, h]

/-- `[H₁, H₂] = ħ³`. -/
lemma exH_comm : exH K 0 * exH K 1 - exH K 1 * exH K 0 = hbar ^ 3 := by
  refine rees_ext fun f => ?_
  simp only [exH_zero, exH_one, sub_smul, mul_smul, add_smul, hd_smul, hx_smul, hbar_smul,
    pow_succ, pow_zero, one_mul]
  simp only [map_add, dSer_X_mul, Derivation.leibniz, smul_eq_mul, dSer_C_X]
  have h := dSer_comm (0 : Fin 2) 1 f
  have h0 := dSer_X (σ := Fin 2) (K := K) 0
  have h1 := dSer_X (σ := Fin 2) (K := K) 1
  simp only [Fin.zero_eta, Fin.isValue, one_ne_zero, ↓reduceIte, zero_ne_one] at h ⊢
  linear_combination X ^ 2 * h + (X * dSer 1 f + 2 * X ^ 2 * C (MvPolynomial.X 0) * f) * h0 -
    X * dSer 0 f * h1

/-- The ideal `⟨ħ∂₁, ħ∂₂ + ħ²x₁⟩` is **not** an Airy ideal, although its generators satisfy
conditions (1)–(3). `[H₁, H₂] = ħ³` lies in `ħ²𝒟̂` but not in `ħ² I`. -/
theorem not_isAiryIdeal_example :
    ¬ IsAiryIdeal (Submodule.span (ReesWeyl (Fin 2) K) (Set.range (exH K))) := by
  intro hI
  set I := Submodule.span (ReesWeyl (Fin 2) K) (Set.range (exH K))
  obtain ⟨T, hT, hTeq⟩ := hI.comm_mem _ (Submodule.subset_span ⟨0, rfl⟩) _
    (Submodule.subset_span ⟨1, rfl⟩)
  rw [exH_comm, pow_succ] at hTeq
  have hbarI : hbar ∈ I := by
    rw [hbar_pow_mul_injective 2 hTeq]
    exact hT
  -- every element of `I` sends `1` into `ħ² K[x]⟦ħ⟧`
  have hdvd : ∀ P ∈ I, X ^ 2 ∣ P • (1 : PolySeries (Fin 2) K) := by
    intro P hP
    obtain ⟨d, rfl⟩ := exists_eq_sum_of_mem_span hP
    rw [Fin.sum_univ_two, add_smul, mul_smul, mul_smul]
    refine dvd_add (X_pow_dvd_smul _ ?_) (X_pow_dvd_smul _ ?_)
    · rw [exH_zero, hd_smul, Derivation.map_one_eq_zero, mul_zero]
      exact dvd_zero _
    · rw [exH_one, add_smul, hd_smul, mul_smul, hx_smul, hbar_smul, Derivation.map_one_eq_zero,
        mul_zero, zero_add, mul_one]
      exact ⟨C (MvPolynomial.X 0), by ring⟩
  have := X_pow_dvd_iff.mp (hdvd _ hbarI) 1 (by norm_num)
  rw [hbar_smul, mul_one, coeff_X, if_pos rfl] at this
  exact one_ne_zero this

end Example

end AiryIdeals
