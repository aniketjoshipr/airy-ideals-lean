import AiryIdeals.AiryIdeal

/-!
# Theorem 2.28 and Corollary 2.33

* `IsAiryIdeal.exists_potential` (**Theorem 2.28**, generator form). An Airy ideal is generated
  by commuting first-order operators `H̄ₐ = ħ∂ₐ + ∑_{n ≥ 2} ħⁿ ∂ₐ q^{(n+1)}(x)`, for a stable
  potential `S = ∑_{n ≥ 2} ħ^{n-1} q^{(n+1)}` (`deg q^{(n+1)} ≤ n+1`, `q^{(n+1)}(0) = 0`). The
  same statement as an image under a transvection automorphism, `I = φ(I_can)`, is in
  `AiryIdeals.Transvection`.
* `IsAiryIdeal.partitionFunction` (**Corollary 2.33**, Kontsevich–Soibelman). There is a unique
  `Z ∈ K[x_A]⟦ħ⟧` with `Z|_{x=0} = 1` that is annihilated by `I`. It has the form
  `Z = exp(F)` with `F = -S`, so `ħᵏ` coefficient of `F` has degree `≤ k + 2`.

Our uniqueness statement is slightly stronger than the paper's: `Z` is unique among *all*
elements of `K[x_A]⟦ħ⟧` normalised by `Z|_{x=0} = 1`, not only among exponentials.
-/

open PowerSeries Finset

namespace AiryIdeals

set_option linter.unusedSectionVars false

variable {σ K : Type*} [Fintype σ] [Field K] [CharZero K]

variable (σ K) in
/-- A **stable potential** `S = ∑_{n ≥ 2} ħ^{n-1} q^{(n+1)}(x)`, normalised by `q^{(n+1)}(0) = 0`.
In terms of `ħᵏ` coefficients: `S₀ = 0` (stability), `deg Sₖ ≤ k + 2`, and `Sₖ(0) = 0`. -/
structure StablePotential where
  /-- The series `S`. -/
  S : PolySeries σ K
  coeff_zero : coeff 0 S = 0
  totalDegree_le : ∀ k, (coeff k S).totalDegree ≤ k + 2
  vanish_at_zero : ∀ k, (coeff k S).coeff 0 = 0

namespace StablePotential

variable (S : StablePotential σ K)

lemma X_mul_dSer_mem (a : σ) : X * dSer a S.S ∈ reesPoly σ K := by
  intro n
  rcases n with _ | k
  · simp
  · rw [coeff_succ_X_mul, coeff_dSer]
    have := S.totalDegree_le k
    exact (totalDegree_pderiv_le_sub _ _).trans (by omega)

/-- `ħ ∂ₐ S = ∑_{n ≥ 2} ħⁿ ∂ₐ q^{(n+1)}`. -/
noncomputable def dPot (a : σ) : reesPoly σ K := ⟨X * dSer a S.S, S.X_mul_dSer_mem a⟩

/-- The commuting first-order operators `H̄ₐ = ħ∂ₐ + ħ ∂ₐ S`. -/
noncomputable def barH (a : σ) : ReesWeyl σ K := barOp S.dPot a

/-- The ideal `⟨H̄ₐ⟩` generated by these operators. It equals `φ_S(I_can)`. -/
noncomputable def ideal : LeftIdeal σ K := Submodule.span (ReesWeyl σ K) (Set.range S.barH)

lemma dPot_coeff (a : σ) :
    coeff 0 (S.dPot a : PolySeries σ K) = 0 ∧ coeff 1 (S.dPot a : PolySeries σ K) = 0 := by
  refine ⟨by simp [dPot], ?_⟩
  change coeff 1 (X * dSer a S.S) = 0
  rw [coeff_succ_X_mul, coeff_dSer, S.coeff_zero, map_zero]

/-- The partition function `Z = exp(-S)`. -/
noncomputable def Z : PolySeries σ K := hexp K (-S.S)

lemma constantCoeff_neg : constantCoeff (-S.S) = 0 := by
  rw [map_neg, ← coeff_zero_eq_constantCoeff_apply, S.coeff_zero, neg_zero]

lemma isUnit_Z : IsUnit S.Z := isUnit_hexp S.constantCoeff_neg

lemma dSer_Z (a : σ) : dSer a S.Z = -dSer a S.S * S.Z := by
  rw [Z, derivation_hexp (dSer a) (MvPolynomial.pderiv a) (fun f n => coeff_dSer a f n)
    S.constantCoeff_neg, map_neg]

/-- `H̄ₐ Z = 0`. -/
lemma barH_smul_Z (a : σ) : S.barH a • S.Z = 0 := by
  rw [barH, barOp_smul, dSer_Z]
  change X * (-dSer a S.S * S.Z) + X * dSer a S.S * S.Z = 0
  ring

lemma smul_Z_eq_zero {P : ReesWeyl σ K} (hP : P ∈ S.ideal) : P • S.Z = 0 := by
  obtain ⟨d, rfl⟩ := exists_eq_sum_of_mem_span hP
  rw [sum_smul]
  exact sum_eq_zero fun a _ => by rw [mul_smul, barH_smul_Z, smul_zero]

end StablePotential

/-- Evaluation at `x = 0`, coefficientwise in `ħ`. -/
noncomputable def evalZero : PolySeries σ K →+* PowerSeries K :=
  PowerSeries.map (MvPolynomial.aeval (0 : σ → K)).toRingHom

lemma hexp_zero {B : Type*} [CommRing B] [Algebra K B] : hexp K (0 : PowerSeries B) = 1 := by
  refine PowerSeries.ext fun n => ?_
  rw [coeff_hexp (map_zero _) (Nat.lt_succ_self n), expTrunc, sum_range_succ']
  rcases n with _ | n
  · simp
  · simp [zero_pow (Nat.succ_ne_zero _), coeff_one]

lemma evalZero_coeff (f : PolySeries σ K) (n : ℕ) :
    coeff n (evalZero f) = (coeff n f).coeff 0 := by
  simp [evalZero, coeff_map, MvPolynomial.constantCoeff_eq]

namespace StablePotential

variable (S : StablePotential σ K)

lemma evalZero_S : evalZero S.S = 0 := by
  refine PowerSeries.ext fun n => ?_
  rw [evalZero_coeff, S.vanish_at_zero, map_zero]

lemma evalZero_Z : evalZero S.Z = 1 := by
  rw [evalZero, Z, map_hexp _ S.constantCoeff_neg, map_neg]
  change hexp K (-evalZero S.S) = 1
  rw [evalZero_S, neg_zero, hexp_zero]

/-- A series all of whose `x`-derivatives vanish is constant in `x`. -/
lemma eq_one_of_dSer_eq_zero {u : PolySeries σ K} (hu : ∀ a, dSer a u = 0)
    (h0 : evalZero u = 1) : u = 1 := by
  refine PowerSeries.ext fun n => ?_
  have hc : coeff n u = MvPolynomial.C ((coeff n u).coeff 0) :=
    eq_C_of_pderiv_eq_zero fun a => by rw [← coeff_dSer, hu a, map_zero]
  have h1 := congrArg (coeff n) h0
  rw [evalZero_coeff] at h1
  rw [hc, h1, coeff_one, coeff_one]
  split_ifs <;> simp

/-- Uniqueness of the partition function. -/
lemma eq_Z {Z' : PolySeries σ K} (hZ' : ∀ a, S.barH a • Z' = 0) (h0 : evalZero Z' = 1) :
    Z' = S.Z := by
  have hd : ∀ a, dSer a Z' = -dSer a S.S * Z' := fun a => by
    have := hZ' a
    rw [barH, barOp_smul] at this
    change X * dSer a Z' + X * dSer a S.S * Z' = 0 at this
    have h : X * (dSer a Z' + dSer a S.S * Z') = X * 0 := by rw [mul_zero, ← this]; ring
    rw [← sub_eq_zero, neg_mul, sub_neg_eq_add]
    exact X_mul_cancel h
  set u := Z' * ↑S.isUnit_Z.unit⁻¹
  have hZu : Z' = u * S.Z := by
    simp [u, mul_assoc]
  have hu : ∀ a, dSer a u = 0 := fun a => by
    have h := hd a
    rw [hZu, Derivation.leibniz, dSer_Z, smul_eq_mul, smul_eq_mul] at h
    have : dSer a u * S.Z = 0 := by linear_combination h
    exact (IsUnit.mul_left_eq_zero S.isUnit_Z).mp this
  have h0u : evalZero u = 1 := by
    have := congrArg evalZero hZu
    rwa [map_mul, evalZero_Z, mul_one, h0, eq_comm] at this
  rw [hZu, eq_one_of_dSer_eq_zero hu h0u, one_mul]

end StablePotential

/-! ### Theorem 2.28 -/

lemma IsBigOHbarSq.coeff {H : ReesWeyl σ K} {a : σ} (h : IsBigOHbarSq (H - hd a)) :
    coeff 0 (H : OpSeries σ K) = 0 ∧ coeff 1 (H : OpSeries σ K) = dOp a := by
  obtain ⟨h0, h1⟩ := h
  simp only [Subalgebra.coe_sub, map_sub, coe_hd, coeff_C_mul, coeff_zero_X, coeff_one_X,
    mul_zero, mul_one, sub_zero, sub_eq_zero] at h0 h1
  exact ⟨h0, h1⟩

/-- **Theorem 2.28** (generator form). An Airy ideal is generated by the commuting first-order
operators `H̄ₐ = ħ∂ₐ + ħ∂ₐ S` of some stable potential `S`. -/
theorem IsAiryIdeal.exists_potential {I : LeftIdeal σ K} (hI : IsAiryIdeal I) :
    ∃ S : StablePotential σ K, I = S.ideal := by
  obtain ⟨H, hIH, hH⟩ := hI.exists_gens
  have hG0 : ∀ a, coeff 0 (H a : OpSeries σ K) = 0 := fun a => (hH a).coeff.1
  have hG1 : ∀ a, coeff 1 (H a : OpSeries σ K) = dOp a := fun a => (hH a).coeff.2
  choose g c hgc hvan using fun a => exists_poly_add H hG0 hG1 (H a - hd a)
  have hg : ∀ a, coeff 0 (g a : PolySeries σ K) = 0 ∧ coeff 1 (g a : PolySeries σ K) = 0 :=
    fun a => ⟨(hvan a (hH a).1 (hH a).2).1, (hvan a (hH a).1 (hH a).2).2.1⟩
  have hc : ∀ a b, coeff 0 (c a b : OpSeries σ K) = 0 :=
    fun a => (hvan a (hH a).1 (hH a).2).2.2
  have hHc : ∀ a, H a = barOp g a + ∑ b, c a b * H b := fun a => by
    rw [barOp, add_assoc, ← hgc a]; abel
  let S : StablePotential σ K :=
    { S := potential g
      coeff_zero := coeff_zero_potential g hg
      totalDegree_le := fun k => by
        rw [potential, coeff_mk]
        exact totalDegree_primitive_le fun a => omega_totalDegree g hg (k + 1) a
      vanish_at_zero := fun k => by rw [potential, coeff_mk]; exact coeff_zero_primitive _ }
  have hdPot : S.dPot = g := funext fun a =>
    Subtype.ext (g_eq_potential hIH hI.comm_mem hg hc hHc a).symm
  have hb : S.barH = barOp g := by
    funext a
    exact congrArg (fun g => barOp g a) hdPot
  refine ⟨S, ?_⟩
  rw [StablePotential.ideal, hb]
  exact eq_span_barOp hIH hI.comm_mem hg hc hHc

/-! ### Corollary 2.33 -/

/-- **Corollary 2.33** (existence and uniqueness of the partition function). An Airy ideal
annihilates a unique `Z ∈ K[x_A]⟦ħ⟧` with `Z|_{x=0} = 1`. -/
theorem IsAiryIdeal.existsUnique_partitionFunction {I : LeftIdeal σ K} (hI : IsAiryIdeal I) :
    ∃! Z : PolySeries σ K, evalZero Z = 1 ∧ ∀ P ∈ I, P • Z = 0 := by
  obtain ⟨S, rfl⟩ := hI.exists_potential
  refine ⟨S.Z, ⟨S.evalZero_Z, fun P hP => S.smul_Z_eq_zero hP⟩, fun Z' ⟨h0, hZ'⟩ => ?_⟩
  exact S.eq_Z (fun a => hZ' _ (Submodule.subset_span ⟨a, rfl⟩)) h0

/-- **Corollary 2.33** (form of the partition function). The partition function is
`Z = exp(F)`, where `F` has no `ħ⁰` term, `deg Fₖ ≤ k + 2` and `Fₖ(0) = 0`. Equivalently
`Z = exp(∑_{2g-2+n>0} ħ^{2g-2+n} F_{g,n})`, with `F_{g,n}` homogeneous of degree `n`. -/
theorem IsAiryIdeal.partitionFunction_eq_exp {I : LeftIdeal σ K} (hI : IsAiryIdeal I) :
    ∃ F : PolySeries σ K, coeff 0 F = 0 ∧ (∀ k, (coeff k F).totalDegree ≤ k + 2) ∧
      (∀ k, (coeff k F).coeff 0 = 0) ∧ evalZero (hexp K F) = 1 ∧
        ∀ P ∈ I, P • hexp K F = 0 := by
  obtain ⟨S, rfl⟩ := hI.exists_potential
  refine ⟨-S.S, by rw [map_neg, S.coeff_zero, neg_zero], fun k => ?_, fun k => ?_, S.evalZero_Z,
    fun P hP => S.smul_Z_eq_zero hP⟩
  · rw [map_neg, MvPolynomial.totalDegree_neg]; exact S.totalDegree_le k
  · rw [map_neg, MvPolynomial.coeff_neg, S.vanish_at_zero, neg_zero]

end AiryIdeals
