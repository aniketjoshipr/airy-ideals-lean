import AiryIdeals.Rees

/-!
# Lemma 2.18: every operator is a polynomial modulo the ideal

Let `G₍ₐ₎ ∈ 𝒟̂_A^ħ` be operators of the form `Gₐ = ħ∂ₐ + O(ħ²)`. Lemma 2.18 says that every
`P ∈ 𝒟̂_A^ħ` can be written as
`P = ∑ₙ ħⁿ pₙ(x) + ∑ₐ cₐ Gₐ`, with `deg pₙ ≤ n`.

As in the paper, the proof works order by order in `ħ`. At order `ħ^{m+1}`, we normal-order
what is left (`bernstein_decomp`). This splits off a polynomial and moves one derivative to the
right, `ħ∂ₐ = Gₐ + O(ħ²)`. The resulting `ħ^m` coefficient of `cₐ` is fed into the next order.
In Lean this is a well-founded recursion, `lemCoeff`. The `ħ`-adic completeness of
`𝒟̂_A^ħ` is what lets us take all orders at once.

We also record that if `P = O(ħ²)` then the polynomial part is `O(ħ²)` and the `cₐ` are
`O(ħ)`. The proof of Lemma 2.21 needs this.
-/

open PowerSeries Finset

namespace AiryIdeals

set_option linter.unusedSectionVars false

variable {σ K : Type*} [Fintype σ] [Field K] [CharZero K]

open Classical in
/-- A choice of normal form for `T ∈ F (n+1)`. It is the trivial one when `T = 0`. -/
noncomputable def nf (n : ℕ) (T : Op σ K) : MvPolynomial σ K × (σ → Op σ K) :=
  if T = 0 then (0, 0) else
    if h : NormalForm n T then (h.choose, h.choose_spec.2.choose) else (0, 0)

lemma nf_zero (n : ℕ) : nf n (0 : Op σ K) = (0, 0) := by simp [nf]

lemma nf_spec {n : ℕ} {T : Op σ K} (hT : T ∈ bernstein σ K (n + 1)) :
    (nf n T).1.totalDegree ≤ n + 1 ∧ (∀ a, (nf n T).2 a ∈ bernstein σ K n) ∧
      T = mulOp (nf n T).1 + ∑ a, (nf n T).2 a * dOp a := by
  classical
  by_cases h0 : T = 0
  · subst h0
    simp only [nf_zero, MvPolynomial.totalDegree_zero, zero_le, Pi.zero_apply, zero_mem,
      implies_true, map_zero, zero_mul, sum_const_zero, add_zero, and_self]
  · have h := bernstein_decomp hT
    have e : nf n T = (h.choose, h.choose_spec.2.choose) := by simp [nf, h0, h]
    rw [e]
    exact ⟨h.choose_spec.1, h.choose_spec.2.choose_spec.1, h.choose_spec.2.choose_spec.2⟩

/-- The coefficients `c_{a,m}` (the `ħᵐ` coefficient of `cₐ`) in the proof of Lemma 2.18. -/
noncomputable def lemCoeff (P : OpSeries σ K) (G : σ → OpSeries σ K) : ℕ → σ → Op σ K
  | m => (nf m (coeff (m + 1) P -
      ∑ a, ∑ i : Fin m, lemCoeff P G i a * coeff (m + 1 - i) (G a))).2
termination_by m => m
decreasing_by exact i.isLt

/-- The operator that still has to be normal-ordered at order `ħ^{m+1}`. -/
noncomputable def lemRest (P : OpSeries σ K) (G : σ → OpSeries σ K) (m : ℕ) : Op σ K :=
  coeff (m + 1) P - ∑ a, ∑ i : Fin m, lemCoeff P G i a * coeff (m + 1 - i) (G a)

lemma lemCoeff_eq (P : OpSeries σ K) (G : σ → OpSeries σ K) (m : ℕ) :
    lemCoeff P G m = (nf m (lemRest P G m)).2 := by
  rw [lemCoeff, lemRest]

/-- The polynomial part `∑ ħⁿ pₙ` in Lemma 2.18. -/
noncomputable def lemPoly (P : OpSeries σ K) (G : σ → OpSeries σ K) : PolySeries σ K :=
  PowerSeries.mk fun n => match n with
    | 0 => coeff 0 P 1
    | m + 1 => (nf m (lemRest P G m)).1

section

variable {P : OpSeries σ K} {G : σ → OpSeries σ K}

lemma lemCoeff_mem (hP : P ∈ rees σ K) (hG : ∀ a, G a ∈ rees σ K) (m : ℕ) :
    (∀ a, lemCoeff P G m a ∈ bernstein σ K m) ∧ lemRest P G m ∈ bernstein σ K (m + 1) := by
  induction m using Nat.strong_induction_on with
  | _ m ih =>
    have hR : lemRest P G m ∈ bernstein σ K (m + 1) := by
      refine sub_mem (hP _) (sum_mem fun b _ => sum_mem fun i _ => ?_)
      have := bernstein_mul_mem ((ih i i.isLt).1 b) (hG b (m + 1 - i))
      rwa [show (i : ℕ) + (m + 1 - i) = m + 1 by omega] at this
    exact ⟨fun a => by rw [lemCoeff_eq]; exact (nf_spec hR).2.1 a, hR⟩

lemma lemPoly_mem (hP : P ∈ rees σ K) (hG : ∀ a, G a ∈ rees σ K) : lemPoly P G ∈ reesPoly σ K := by
  intro n
  rcases n with _ | m
  · obtain ⟨r, hr⟩ := mem_bernstein_zero (hP 0)
    simp only [lemPoly, coeff_mk, hr, mulOp_apply, mul_one]
    simp
  · simp only [lemPoly, coeff_mk]
    exact (nf_spec (lemCoeff_mem hP hG m).2).1

end

/-- The series `cₐ = ∑ₘ ħᵐ c_{a,m}`. -/
noncomputable def lemSeries (P : OpSeries σ K) (G : σ → OpSeries σ K) (a : σ) : OpSeries σ K :=
  PowerSeries.mk fun m => lemCoeff P G m a

lemma coeff_lemSeries (P : OpSeries σ K) (G : σ → OpSeries σ K) (a : σ) (m : ℕ) :
    coeff m (lemSeries P G a) = lemCoeff P G m a := coeff_mk _ _

/-- **Lemma 2.18.** Let `Gₐ = ħ∂ₐ + O(ħ²)` lie in `𝒟̂_A^ħ`. Then every `P ∈ 𝒟̂_A^ħ` is a polynomial
series plus an element of the left ideal generated by the `Gₐ`. If moreover `P = O(ħ²)`, the
polynomial part is `O(ħ²)` and the coefficients `cₐ` are `O(ħ)`. -/
theorem exists_poly_add (G : σ → ReesWeyl σ K)
    (hG0 : ∀ a, coeff 0 (G a : OpSeries σ K) = 0) (hG1 : ∀ a, coeff 1 (G a : OpSeries σ K) = dOp a)
    (P : ReesWeyl σ K) :
    ∃ g : reesPoly σ K, ∃ c : σ → ReesWeyl σ K, P = polyOp g + ∑ a, c a * G a ∧
      (coeff 0 (P : OpSeries σ K) = 0 → coeff 1 (P : OpSeries σ K) = 0 →
        coeff 0 (g : PolySeries σ K) = 0 ∧ coeff 1 (g : PolySeries σ K) = 0 ∧
          ∀ a, coeff 0 (c a : OpSeries σ K) = 0) := by
  classical
  set P' : OpSeries σ K := Subtype.val P
  set G' : σ → OpSeries σ K := fun a => Subtype.val (G a)
  have hP : P' ∈ rees σ K := P.2
  have hG : ∀ a, G' a ∈ rees σ K := fun a => (G a).2
  refine ⟨⟨lemPoly P' G', lemPoly_mem hP hG⟩,
    fun a => ⟨lemSeries P' G' a, mem_rees.mpr fun m => by
      rw [coeff_lemSeries]; exact (lemCoeff_mem hP hG m).1 a⟩, ?_, ?_⟩
  · apply Subtype.ext
    refine PowerSeries.ext fun n => ?_
    simp only [Subalgebra.coe_add, AddSubmonoidClass.coe_finsetSum, Subalgebra.coe_mul, polyOp,
      map_add, coeff_map, map_sum]
    rcases n with _ | m
    · obtain ⟨r, hr⟩ := mem_bernstein_zero (hP 0)
      change coeff 0 P' = mulOp.toRingHom (coeff 0 (lemPoly P' G')) +
        ∑ a, coeff 0 (lemSeries P' G' a * G' a)
      have h0 : ∀ a, coeff 0 (lemSeries P' G' a * G' a) = 0 := fun a => by
        rw [coeff_zero_eq_constantCoeff_apply, map_mul, ← coeff_zero_eq_constantCoeff_apply (G' a),
          show coeff 0 (G' a) = 0 from hG0 a, mul_zero]
      simp only [h0, sum_const_zero, add_zero]
      rw [show coeff 0 (lemPoly P' G') = coeff 0 P' 1 from coeff_mk _ _, hr]
      simp [Algebra.algebraMap_eq_smul_one]
    · have hspec := (nf_spec (lemCoeff_mem hP hG m).2).2.2
      have hsum : ∀ a, coeff (m + 1) (lemSeries P' G' a * G' a) =
          ∑ i : Fin m, lemCoeff P' G' i a * coeff (m + 1 - i) (G' a) +
            (nf m (lemRest P' G' m)).2 a * dOp a := by
        intro a
        rw [coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk, sum_range_succ,
          sum_range_succ, Fin.sum_univ_eq_sum_range (fun i => lemCoeff P' G' i a *
            coeff (m + 1 - i) (G' a)) m]
        simp only [coeff_lemSeries, Nat.sub_self, show m + 1 - m = 1 by omega,
          lemCoeff_eq P' G' m]
        rw [show coeff 0 (G' a) = 0 from hG0 a, show coeff 1 (G' a) = dOp a from hG1 a,
          mul_zero, add_zero]
      change coeff (m + 1) P' = mulOp.toRingHom (coeff (m + 1) (lemPoly P' G')) +
        ∑ a, coeff (m + 1) (lemSeries P' G' a * G' a)
      rw [sum_congr rfl fun a _ => hsum a, sum_add_distrib,
        show coeff (m + 1) (lemPoly P' G') = (nf m (lemRest P' G' m)).1 from coeff_mk _ _]
      have : coeff (m + 1) P' = lemRest P' G' m +
          ∑ a, ∑ i : Fin m, lemCoeff P' G' i a * coeff (m + 1 - i) (G' a) := by
        simp [lemRest]
      rw [this]
      conv_lhs => rw [hspec]
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      abel
  · intro h0 h1
    have hR : lemRest P' G' 0 = 0 := by simp [lemRest, h1]
    refine ⟨?_, ?_, fun a => ?_⟩
    · change coeff 0 (lemPoly P' G') = 0
      simp [lemPoly, h0]
    · change coeff 1 (lemPoly P' G') = 0
      simp [lemPoly, hR, nf_zero]
    · change coeff 0 (lemSeries P' G' a) = 0
      rw [coeff_lemSeries, lemCoeff_eq, hR, nf_zero]; rfl

end AiryIdeals
