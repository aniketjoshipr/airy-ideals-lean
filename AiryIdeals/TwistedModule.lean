import AiryIdeals.Transvection

/-!
# Twisted modules and modules of exponential type (Sections 2.1, 2.3, 2.4)

* `ann_one_iff`: the annihilator of `1 ∈ M̂_A^ħ` is the canonical ideal `I_can` (eq. (2.9)).
  Together with `reesPoly_cyclic`, this gives `M̂_A^ħ ≅ 𝒟̂_A^ħ / I_can`.
* `Twisted φ M`: the twisted module `^φ M`, with action `P ·_φ m = φ⁻¹(P) · m` (Def. 2.3).
* `StablePotential.quotientEquivTwisted` (**Lemma 2.14**):
  `𝒟̂_A^ħ / φ_S(I_can) ≅ ^{φ_S} M̂_A^ħ`.
* `StablePotential.quotientEquivExp` (**Lemma 2.15**): `𝒟̂_A^ħ / φ_S(I_can) ≅ M̂_A^ħ · Z`, the
  module of exponential type generated by `Z = e^{-S}`.
* `IsAiryIdeal.quotientEquivTwisted` and `IsAiryIdeal.quotientEquivExp` (**Theorem 2.17** and
  **Corollary 2.22**, module form). For an Airy ideal `I`, `𝒟̂_A^ħ / I` is isomorphic to a twisted
  polynomial module and to a module of exponential type.
-/

open PowerSeries Finset

namespace AiryIdeals

set_option linter.unusedSectionVars false

variable {σ K : Type*} [Fintype σ] [Field K] [CharZero K]

attribute [local irreducible] StablePotential.transvection

/-! ### The polynomial module is `𝒟̂ / I_can` -/

lemma one_mem_reesPoly : (1 : PolySeries σ K) ∈ reesPoly σ K := by
  intro n
  rw [coeff_one]
  split_ifs <;> simp

lemma hd_smul_one (a : σ) : (hd a : ReesWeyl σ K) • (1 : PolySeries σ K) = 0 := by
  rw [hd_smul, Derivation.map_one_eq_zero, mul_zero]

/-- The annihilator of `1 ∈ M̂_A^ħ` is the canonical ideal `I_can` generated by the `ħ∂ₐ`. -/
theorem ann_one_iff (P : ReesWeyl σ K) : P • (1 : PolySeries σ K) = 0 ↔ P ∈ Ican σ K := by
  constructor
  · intro hP
    have hG0 : ∀ a, coeff 0 ((hd a : ReesWeyl σ K) : OpSeries σ K) = 0 := fun a => by
      simp [coeff_C_mul]
    have hG1 : ∀ a, coeff 1 ((hd a : ReesWeyl σ K) : OpSeries σ K) = dOp a := fun a => by
      simp [coeff_C_mul]
    obtain ⟨g, c, hgc, -⟩ := exists_poly_add hd hG0 hG1 P
    have hg : (g : PolySeries σ K) = 0 := by
      rw [hgc, add_smul, sum_smul, act_polyOp_one] at hP
      simpa [mul_smul, hd_smul_one] using hP
    have h0 : polyOp g = 0 := by
      apply Subtype.ext; simp [polyOp, hg]
    rw [hgc, h0, zero_add]
    exact sum_mem fun a _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨a, rfl⟩)
  · intro hP
    obtain ⟨d, rfl⟩ := exists_eq_sum_of_mem_span hP
    rw [sum_smul]
    exact sum_eq_zero fun a _ => by rw [mul_smul, hd_smul_one, smul_zero]

/-- `M̂_A^ħ` is cyclic, generated by `1`. -/
lemma reesPoly_cyclic (f : reesPoly σ K) : polyOp f • (1 : PolySeries σ K) = f :=
  act_polyOp_one f

/-! ### Twisted modules -/

/-- The twisted module `^φ M`. It has the same underlying group as `M`, with action
`P ·_φ m = φ⁻¹(P) · m`. -/
def Twisted (_φ : ReesWeyl σ K ≃ₐ[K] ReesWeyl σ K) (M : Type*) : Type _ := M

namespace Twisted

variable (φ : ReesWeyl σ K ≃ₐ[K] ReesWeyl σ K) (M : Type*) [AddCommGroup M]
  [Module (ReesWeyl σ K) M]

instance : AddCommGroup (Twisted φ M) := inferInstanceAs (AddCommGroup M)

noncomputable instance : Module (ReesWeyl σ K) (Twisted φ M) :=
  Module.compHom M φ.symm.toAlgHom.toRingHom

variable {M}

/-- The identity map `M → ^φ M`. -/
def of : M ≃+ Twisted φ M := AddEquiv.refl M

lemma smul_of (P : ReesWeyl σ K) (m : M) : P • of φ m = of φ (φ.symm P • m) := rfl

end Twisted

/-- Given an automorphism `φ` and a generator `v` of a cyclic module `M` whose annihilator is `J`,
`𝒟̂ / φ(J) ≅ ^φ M` (Section 2.1). Here `φ(J)` is described as `{P | φ⁻¹ P ∈ J}`. -/
noncomputable def quotientEquivTwistedOfCyclic (φ : ReesWeyl σ K ≃ₐ[K] ReesWeyl σ K)
    {M : Type*} [AddCommGroup M] [Module (ReesWeyl σ K) M] (v : M)
    (hv : ∀ m : M, ∃ P : ReesWeyl σ K, P • v = m) (I : LeftIdeal σ K)
    (hI : ∀ P, P ∈ I ↔ φ.symm P • v = 0) :
    (ReesWeyl σ K ⧸ I) ≃ₗ[ReesWeyl σ K] Twisted φ M := by
  let ψ : ReesWeyl σ K →ₗ[ReesWeyl σ K] Twisted φ M :=
    { toFun := fun P => Twisted.of φ (φ.symm P • v)
      map_add' := fun P Q => by simp [add_smul]
      map_smul' := fun Q P => by
        simp only [smul_eq_mul, map_mul, mul_smul, RingHom.id_apply, Twisted.smul_of] }
  have hker : LinearMap.ker ψ = I := by
    ext P
    rw [LinearMap.mem_ker, hI]
    exact Iff.rfl
  have hsurj : Function.Surjective ψ := fun m => by
    obtain ⟨P, hP⟩ := hv ((Twisted.of φ).symm m)
    refine ⟨φ P, ?_⟩
    change Twisted.of φ (φ.symm (φ P) • v) = m
    rw [AlgEquiv.symm_apply_apply, hP]
    rfl
  exact (Submodule.quotEquivOfEq _ _ hker.symm).trans (LinearMap.quotKerEquivOfSurjective ψ hsurj)

namespace StablePotential

variable (S : StablePotential σ K)

/-- The generator `1` of `M̂_A^ħ`. -/
noncomputable def reesPolyOne : reesPoly σ K := ⟨1, one_mem_reesPoly⟩

omit S in
lemma reesPolyOne_cyclic (f : reesPoly σ K) : ∃ P : ReesWeyl σ K, P • reesPolyOne = f :=
  ⟨polyOp f, Subtype.ext (reesPoly_cyclic f)⟩

/-- **Lemma 2.14.** `𝒟̂_A^ħ / φ_S(I_can)` is isomorphic to the twisted module `^{φ_S} M̂_A^ħ`. -/
noncomputable def quotientEquivTwisted :
    (ReesWeyl σ K ⧸ S.ideal) ≃ₗ[ReesWeyl σ K] Twisted S.transvection (reesPoly σ K) :=
  quotientEquivTwistedOfCyclic (M := reesPoly σ K) S.transvection reesPolyOne
    (fun f => reesPolyOne_cyclic f) S.ideal (fun P => by
      rw [S.mem_ideal_iff, ← ann_one_iff, ← Submodule.coe_eq_zero, Submodule.coe_smul]
      rfl)

/-- The module of exponential type `M̂_A^ħ · Z` generated by `Z = e^{-S}` (Definition 2.11). -/
noncomputable def expModule : Submodule (ReesWeyl σ K) (PolySeries σ K) where
  carrier := {h | ∃ f ∈ reesPoly σ K, h = S.Z * f}
  zero_mem' := ⟨0, zero_mem _, by simp⟩
  add_mem' := by
    rintro _ _ ⟨f, hf, rfl⟩ ⟨g, hg, rfl⟩
    exact ⟨f + g, add_mem hf hg, by ring⟩
  smul_mem' := by
    rintro P _ ⟨f, hf, rfl⟩
    refine ⟨S.transvection.symm P • f, Submodule.smul_mem _ _ hf, ?_⟩
    rw [transvection_symm_smul, ← mul_assoc, S.Z_mul_Zinv, one_mul]

/-- `^{φ_S} M̂_A^ħ ≅ M̂_A^ħ · Z`, via `f ↦ Z f`. -/
noncomputable def twistedEquivExp :
    Twisted S.transvection (reesPoly σ K) ≃ₗ[ReesWeyl σ K] S.expModule where
  toFun f := ⟨S.Z * ((Twisted.of _).symm f : reesPoly σ K), _, ((Twisted.of _).symm f).2, rfl⟩
  invFun h := Twisted.of _ ⟨S.Zinv * h, by
    obtain ⟨f, hf, hh⟩ := h.2
    rw [hh, ← mul_assoc, S.Zinv_mul_Z, one_mul]
    exact hf⟩
  map_add' f g := by
    apply Subtype.ext
    simp only [map_add, Submodule.coe_add, mul_add]
  map_smul' P f := by
    apply Subtype.ext
    simp only [Submodule.coe_smul, RingHom.id_apply]
    change S.Z * (S.transvection.symm P •
        (((Twisted.of S.transvection).symm f : reesPoly σ K) : PolySeries σ K)) =
      P • (S.Z * (((Twisted.of S.transvection).symm f : reesPoly σ K) : PolySeries σ K))
    rw [transvection_symm_smul, ← mul_assoc, S.Z_mul_Zinv, one_mul]
  left_inv f := by
    change Twisted.of _ ⟨S.Zinv * (S.Z * _), _⟩ = f
    simp only [← mul_assoc, S.Zinv_mul_Z, one_mul]
    rfl
  right_inv h := by
    apply Subtype.ext
    change S.Z * (S.Zinv * (h : PolySeries σ K)) = h
    rw [← mul_assoc, S.Z_mul_Zinv, one_mul]

/-- **Lemma 2.15.** `𝒟̂_A^ħ / φ_S(I_can)` is isomorphic to the module of exponential type
`M̂_A^ħ · Z`, `Z = e^{-S}`. -/
noncomputable def quotientEquivExp :
    (ReesWeyl σ K ⧸ S.ideal) ≃ₗ[ReesWeyl σ K] S.expModule :=
  S.quotientEquivTwisted.trans S.twistedEquivExp

end StablePotential

/-- **Theorem 2.17** (module form). For an Airy ideal `I` there is a stable transvection `φ_S` with
`𝒟̂_A^ħ / I ≅ ^{φ_S} M̂_A^ħ`. -/
theorem IsAiryIdeal.quotientEquivTwisted {I : LeftIdeal σ K} (hI : IsAiryIdeal I) :
    ∃ S : StablePotential σ K,
      Nonempty ((ReesWeyl σ K ⧸ I) ≃ₗ[ReesWeyl σ K] Twisted S.transvection (reesPoly σ K)) := by
  obtain ⟨S, rfl⟩ := hI.exists_potential
  exact ⟨S, ⟨S.quotientEquivTwisted⟩⟩

/-- **Corollary 2.22** (module form). For an Airy ideal `I`, `𝒟̂_A^ħ / I` is isomorphic to the module
of exponential type `M̂_A^ħ · Z` generated by its partition function `Z = e^{-S}`. -/
theorem IsAiryIdeal.quotientEquivExp {I : LeftIdeal σ K} (hI : IsAiryIdeal I) :
    ∃ S : StablePotential σ K,
      Nonempty ((ReesWeyl σ K ⧸ I) ≃ₗ[ReesWeyl σ K] S.expModule) := by
  obtain ⟨S, rfl⟩ := hI.exists_potential
  exact ⟨S, ⟨S.quotientEquivExp⟩⟩

end AiryIdeals
