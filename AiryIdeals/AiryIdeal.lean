import AiryIdeals.Decomposition
import AiryIdeals.Exp

/-!
# Airy ideals (Section 2.5): Lemmas 2.19–2.21 and the main theorem

We define Airy ideals (Definition 2.16, for a finite index set `A`). We then prove the key
structural result (Theorem 2.17). Every Airy ideal `I` is generated by commuting first-order
operators
`H̄ₐ = ħ∂ₐ + ħ ∂ₐ S`,  `S = ∑_{n ≥ 2} ħ^{n-1} q^{(n+1)}(x)`,
with `deg q^{(n+1)} ≤ n+1` and `q^{(n+1)}(0) = 0`. In other words `I` is the image of the
canonical ideal `I_can = 𝒟̂·{ħ∂ₐ}` under a stable transvection. The automorphism itself is
built in `AiryIdeals.Transvection`.

The proof follows the paper:
* **Lemma 2.19.** Replace the generators `Hₐ` by `H̄ₐ = ħ∂ₐ + (polynomial) ∈ I`
  (from Lemma 2.18).
* **Lemma 2.21.** `I` contains no nonzero polynomials. This is an induction on the order in
  `ħ`. The paper conjugates by the truncated transvections `φ_N`. Here we let the operators
  act on the exponential `E = exp(-S)` in `K[x_A]⟦ħ⟧` and track `ħ`-adic valuations. This is
  the same argument, written in the language of the "differential equations" viewpoint of the
  paper.
* **Lemma 2.20.** The `H̄ₐ` generate `I`.
* Poincaré's lemma (`AiryIdeals.Poincare`) turns the commutation relations `[H̄ₐ, H̄_b] = 0`
  into `H̄ₐ = ħ∂ₐ + ħ ∂ₐ S`.
-/

open PowerSeries Finset

namespace AiryIdeals

set_option linter.unusedSectionVars false

variable {σ K : Type*} [Fintype σ] [Field K] [CharZero K]

/-- Left ideals of the completed Rees Weyl algebra. -/
abbrev LeftIdeal (σ K : Type*) [Field K] := Submodule (ReesWeyl σ K) (ReesWeyl σ K)

/-- `P = O(ħ²)`: the `ħ⁰` and `ħ¹` coefficients of `P` vanish. -/
def IsBigOHbarSq (P : ReesWeyl σ K) : Prop :=
  coeff 0 (P : OpSeries σ K) = 0 ∧ coeff 1 (P : OpSeries σ K) = 0

/-- **Definition 2.16** (Airy ideal), for a finite index set `A = σ`. A left ideal
`I ⊆ 𝒟̂_A^ħ` is an Airy ideal if:
1. (boundedness: automatic when `A` is finite);
2. `I` is generated by operators `Hₐ`, `a ∈ A`;
3. `Hₐ = ħ∂ₐ + O(ħ²)`;
4. `[I, I] ⊆ ħ² I`. -/
structure IsAiryIdeal (I : LeftIdeal σ K) : Prop where
  exists_gens : ∃ H : σ → ReesWeyl σ K,
    I = Submodule.span (ReesWeyl σ K) (Set.range H) ∧ ∀ a, IsBigOHbarSq (H a - hd a)
  comm_mem : ∀ P ∈ I, ∀ Q ∈ I, ∃ T ∈ I, P * Q - Q * P = hbar ^ 2 * T

variable (σ K) in
/-- The canonical left ideal `I_can`, generated by the derivatives `ħ∂ₐ`. -/
noncomputable def Ican : LeftIdeal σ K := Submodule.span (ReesWeyl σ K) (Set.range hd)

/-! ### Basic facts about the action -/

lemma hd_smul (a : σ) (f : PolySeries σ K) : (hd a : ReesWeyl σ K) • f = X * dSer a f :=
  act_hd a f

lemma polyOp_smul (g : reesPoly σ K) (f : PolySeries σ K) :
    polyOp g • f = (g : PolySeries σ K) * f :=
  act_polyOp g f

lemma hbar_smul (f : PolySeries σ K) : (hbar : ReesWeyl σ K) • f = X * f :=
  act_hbar f

lemma act_X_pow_mul (P : OpSeries σ K) (k : ℕ) (f : PolySeries σ K) :
    act P (X ^ k * f) = X ^ k * act P f := by
  induction k with
  | zero => simp
  | succ k ih => rw [pow_succ', mul_assoc, act_mul_X, ih, ← mul_assoc, ← pow_succ']

/-- The action preserves the `ħ`-adic filtration. -/
lemma X_pow_dvd_smul (P : ReesWeyl σ K) {k : ℕ} {f : PolySeries σ K} (h : X ^ k ∣ f) :
    X ^ k ∣ P • f := by
  obtain ⟨f', rfl⟩ := h
  rw [rees_smul_def, act_X_pow_mul]
  exact dvd_mul_right _ _

/-- Operators that are `O(ħ)` raise the `ħ`-adic valuation by one. -/
lemma X_pow_succ_dvd_smul {P : ReesWeyl σ K} (hP : coeff 0 (P : OpSeries σ K) = 0) {k : ℕ}
    {f : PolySeries σ K} (h : X ^ k ∣ f) : X ^ (k + 1) ∣ P • f := by
  obtain ⟨P', hP'⟩ : (X : OpSeries σ K) ∣ (P : OpSeries σ K) :=
    X_dvd_iff.mpr (by rwa [← coeff_zero_eq_constantCoeff_apply])
  obtain ⟨f', rfl⟩ := h
  rw [rees_smul_def, hP', act_X_mul, act_X_pow_mul, ← mul_assoc, ← pow_succ']
  exact dvd_mul_right _ _

lemma dSer_comm (a b : σ) (f : PolySeries σ K) : dSer a (dSer b f) = dSer b (dSer a f) := by
  refine PowerSeries.ext fun n => ?_
  simp only [coeff_dSer, MvPolynomial.pderiv_comm]

lemma eq_zero_of_forall_X_pow_dvd {f : PolySeries σ K} (h : ∀ N, X ^ N ∣ f) : f = 0 := by
  refine PowerSeries.ext fun n => ?_
  rw [map_zero]
  exact X_pow_dvd_iff.mp (h (n + 1)) n (Nat.lt_succ_self n)

/-- Elements of a left ideal generated by `H` (finite family) act through the `H`'s. -/
lemma exists_eq_sum_of_mem_span {H : σ → ReesWeyl σ K} {P : ReesWeyl σ K}
    (hP : P ∈ Submodule.span (ReesWeyl σ K) (Set.range H)) :
    ∃ d : σ → ReesWeyl σ K, P = ∑ a, d a * H a := by
  obtain ⟨d, hd⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hP
  exact ⟨d, by rw [← hd]; rfl⟩

/-! ### First-order operators `H̄ₐ = ħ∂ₐ + gₐ` with `gₐ` polynomial -/

/-- The operator `H̄ₐ = ħ∂ₐ + gₐ(x, ħ)`. -/
noncomputable def barOp (g : σ → reesPoly σ K) (a : σ) : ReesWeyl σ K := hd a + polyOp (g a)

lemma barOp_smul (g : σ → reesPoly σ K) (a : σ) (f : PolySeries σ K) :
    barOp g a • f = X * dSer a f + (g a : PolySeries σ K) * f := by
  rw [barOp, add_smul, hd_smul, polyOp_smul]

section FirstOrder

variable (g : σ → reesPoly σ K)

/-- The coefficient `ωₙ = ∑ₐ (ħⁿ coefficient of gₐ) dxₐ`, as a polynomial one-form. -/
noncomputable def omega (n : ℕ) (a : σ) : MvPolynomial σ K := coeff n (g a : PolySeries σ K)

/-- The candidate potential `S = ∑ₖ ħᵏ ∫ ω_{k+1}`, built with the explicit Poincaré
primitive. -/
noncomputable def potential : PolySeries σ K :=
  PowerSeries.mk fun k => primitive (omega g (k + 1))

/-- `δ_{ab} = ∂ₐ g_b - ∂_b gₐ`. -/
noncomputable def curl (a b : σ) : PolySeries σ K :=
  dSer a (g b : PolySeries σ K) - dSer b (g a : PolySeries σ K)

/-- `r_{ab} = δ_{ab} / ħ`. -/
noncomputable def curlDiv (a b : σ) : PolySeries σ K :=
  PowerSeries.mk fun n => coeff (n + 1) (curl g a b)

variable (hg : ∀ a, coeff 0 (g a : PolySeries σ K) = 0 ∧ coeff 1 (g a : PolySeries σ K) = 0)
include hg

lemma omega_zero (a : σ) : omega g 0 a = 0 := (hg a).1
lemma omega_one (a : σ) : omega g 1 a = 0 := (hg a).2

lemma omega_totalDegree (n : ℕ) (a : σ) : (omega g n a).totalDegree ≤ n := (g a).2 n

lemma coeff_zero_potential : coeff 0 (potential g) = 0 := by
  rw [potential, coeff_mk]
  have : omega g 1 = 0 := funext (omega_one g hg)
  rw [this, primitive_zero]

lemma curlDiv_mem (a b : σ) : curlDiv g a b ∈ reesPoly σ K := by
  intro n
  rw [curlDiv, coeff_mk, curl, map_sub, coeff_dSer, coeff_dSer]
  have hb := (g b).2 (n + 1)
  have ha := (g a).2 (n + 1)
  refine (MvPolynomial.totalDegree_sub _ _).trans (max_le ?_ ?_)
  · exact (totalDegree_pderiv_le_sub _ _).trans (by omega)
  · exact (totalDegree_pderiv_le_sub _ _).trans (by omega)

lemma X_mul_curlDiv (a b : σ) : X * curlDiv g a b = curl g a b := by
  conv_rhs => rw [eq_X_mul_shift_add_const (curl g a b)]
  rw [curlDiv, ← coeff_zero_eq_constantCoeff_apply, curl, map_sub, coeff_dSer, coeff_dSer,
    (hg a).1, (hg b).1]
  simp

/-- `[H̄ₐ, H̄_b] = ħ² r_{ab}`, a polynomial. -/
lemma barOp_comm (a b : σ) :
    barOp g a * barOp g b - barOp g b * barOp g a =
      hbar ^ 2 * polyOp ⟨curlDiv g a b, curlDiv_mem g hg a b⟩ := by
  refine rees_ext fun f => ?_
  rw [sub_smul, mul_smul, mul_smul, mul_smul, pow_two, mul_smul, polyOp_smul, hbar_smul,
    hbar_smul]
  simp only [barOp_smul, map_add, Derivation.leibniz, smul_eq_mul, dSer_X, mul_zero, zero_add]
  have h1 := dSer_comm a b f
  have h2 := X_mul_curlDiv g hg a b
  simp only [curl] at h2
  linear_combination X ^ 2 * h1 - X * f * h2

/-- If `ħᴺ` divides every `r_{ab}`, then `ωₘ` is closed for `m ≤ N`. -/
lemma omega_closed_of_dvd {N : ℕ} (h : ∀ a b, X ^ N ∣ curlDiv g a b) {m : ℕ} (hm : m ≤ N)
    (a b : σ) : MvPolynomial.pderiv a (omega g m b) = MvPolynomial.pderiv b (omega g m a) := by
  rcases m with _ | j
  · simp [omega_zero g hg]
  · have := X_pow_dvd_iff.mp (h a b) j (by omega)
    rw [curlDiv, coeff_mk, curl, map_sub, coeff_dSer, coeff_dSer, sub_eq_zero] at this
    exact this

/-- If `ωₘ` is closed for all `m ≤ N`, then `gₐ ≡ ħ ∂ₐ S (mod ħ^{N+1})`. -/
lemma X_pow_dvd_sub_potential {N : ℕ}
    (h : ∀ m ≤ N, ∀ a b,
      MvPolynomial.pderiv a (omega g m b) = MvPolynomial.pderiv b (omega g m a)) (a : σ) :
    X ^ (N + 1) ∣ (g a : PolySeries σ K) - X * dSer a (potential g) := by
  refine X_pow_dvd_iff.mpr fun m hm => ?_
  rw [map_sub, sub_eq_zero]
  rcases m with _ | j
  · simp [(hg a).1]
  · rw [coeff_succ_X_mul, coeff_dSer, potential, coeff_mk,
      pderiv_primitive (fun a b => h (j + 1) (by omega) a b)]
    rfl

/-- The exponential `exp(-S)`. -/
noncomputable def expPot : PolySeries σ K := hexp K (-potential g)

lemma constantCoeff_neg_potential : constantCoeff (-potential g) = 0 := by
  rw [map_neg, ← coeff_zero_eq_constantCoeff_apply, coeff_zero_potential g hg, neg_zero]

lemma dSer_expPot (a : σ) : dSer a (expPot g) = -dSer a (potential g) * expPot g := by
  rw [expPot, derivation_hexp (dSer a) (MvPolynomial.pderiv a) (fun f n => coeff_dSer a f n)
    (constantCoeff_neg_potential g hg), map_neg]

lemma barOp_smul_expPot (a : σ) :
    barOp g a • expPot g = ((g a : PolySeries σ K) - X * dSer a (potential g)) * expPot g := by
  rw [barOp_smul, dSer_expPot g hg]
  ring

end FirstOrder

/-! ### The main induction (Lemma 2.21) -/

section Main

variable {I : LeftIdeal σ K} {H : σ → ReesWeyl σ K} {g : σ → reesPoly σ K}
  {c : σ → σ → ReesWeyl σ K}
  (hI : I = Submodule.span (ReesWeyl σ K) (Set.range H))
  (hcomm : ∀ P ∈ I, ∀ Q ∈ I, ∃ T ∈ I, P * Q - Q * P = hbar ^ 2 * T)
  (hg : ∀ a, coeff 0 (g a : PolySeries σ K) = 0 ∧ coeff 1 (g a : PolySeries σ K) = 0)
  (hc : ∀ a b, coeff 0 (c a b : OpSeries σ K) = 0)
  (hHc : ∀ a, H a = barOp g a + ∑ b, c a b * H b)

include hI hHc in
/-- **Lemma 2.19.** `H̄ₐ ∈ I`. -/
lemma barOp_mem (a : σ) : barOp g a ∈ I := by
  have : barOp g a = H a - ∑ b, c a b * H b := by rw [hHc a]; abel
  rw [this, hI]
  refine sub_mem (Submodule.subset_span ⟨a, rfl⟩) (sum_mem fun b _ => ?_)
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨b, rfl⟩)

include hI hcomm hg hHc in
lemma polyOp_curlDiv_mem (a b : σ) : polyOp ⟨curlDiv g a b, curlDiv_mem g hg a b⟩ ∈ I := by
  obtain ⟨T, hT, hTeq⟩ := hcomm _ (barOp_mem hI hHc a) _ (barOp_mem hI hHc b)
  rw [barOp_comm g hg] at hTeq
  rwa [hbar_pow_mul_injective 2 hTeq]

include hI hcomm hg hc hHc in
/-- The induction step of Lemma 2.21: every polynomial in `I` is `O(ħᴺ)`. -/
lemma X_pow_dvd_of_polyOp_mem (N : ℕ) :
    ∀ f : reesPoly σ K, polyOp f ∈ I → X ^ N ∣ (f : PolySeries σ K) := by
  induction N with
  | zero => intros; exact one_dvd _
  | succ N ih =>
    intro f hf
    -- closedness of the `ωₘ` up to order `N`
    have hclosed := fun m (hm : m ≤ N) => omega_closed_of_dvd g hg
      (fun a b => ih _ (polyOp_curlDiv_mem hI hcomm hg hHc a b)) hm
    set E := expPot g
    -- `H̄ₐ E = O(ħ^{N+1})`
    have hw : ∀ a, X ^ (N + 1) ∣ barOp g a • E := fun a => by
      rw [barOp_smul_expPot g hg]
      exact Dvd.dvd.mul_right (X_pow_dvd_sub_potential g hg hclosed a) _
    -- `Hₐ E = O(ħ^{N+1})`, bootstrapping through `Hₐ = H̄ₐ + ∑ c_{ab} H_b`
    have hv : ∀ k ≤ N + 1, ∀ a, X ^ k ∣ H a • E := by
      intro k
      induction k with
      | zero => intros; exact one_dvd _
      | succ k ihk =>
        intro hk a
        rw [hHc a, add_smul, sum_smul]
        refine dvd_add ((pow_dvd_pow X hk).trans (hw a)) (Finset.dvd_sum fun b _ => ?_)
        rw [mul_smul]
        exact X_pow_succ_dvd_smul (hc a b) (ihk (by omega) b)
    -- `f E = O(ħ^{N+1})`, hence `f = O(ħ^{N+1})`
    rw [hI] at hf
    obtain ⟨d, hd⟩ := exists_eq_sum_of_mem_span hf
    have hfE : (f : PolySeries σ K) * E = ∑ a, d a • (H a • E) := by
      rw [← polyOp_smul, hd, sum_smul]
      exact sum_congr rfl fun a _ => mul_smul _ _ _
    have : X ^ (N + 1) ∣ (f : PolySeries σ K) * E := by
      rw [hfE]
      exact Finset.dvd_sum fun a _ => X_pow_dvd_smul _ (hv _ le_rfl a)
    exact (IsUnit.dvd_mul_right (isUnit_hexp (constantCoeff_neg_potential g hg))).mp this

include hI hcomm hg hc hHc in
/-- **Lemma 2.21.** An Airy ideal contains no nonzero polynomials. -/
theorem polyOp_mem_eq_zero {f : reesPoly σ K} (hf : polyOp f ∈ I) : f = 0 :=
  Subtype.ext (eq_zero_of_forall_X_pow_dvd fun N => X_pow_dvd_of_polyOp_mem hI hcomm hg hc hHc N f hf)

include hI hcomm hg hc hHc in
/-- The `H̄ₐ` commute, so every `ωₘ` is closed. -/
lemma omega_closed (m : ℕ) (a b : σ) :
    MvPolynomial.pderiv a (omega g m b) = MvPolynomial.pderiv b (omega g m a) := by
  have h0 : ∀ a b, curlDiv g a b = 0 := fun a b =>
    congrArg Subtype.val (polyOp_mem_eq_zero hI hcomm hg hc hHc (polyOp_curlDiv_mem hI hcomm hg hHc a b))
  exact omega_closed_of_dvd g hg (N := m) (fun a b => by rw [h0]; exact dvd_zero _) le_rfl a b

include hI hcomm hg hc hHc in
/-- `gₐ = ħ ∂ₐ S`. -/
lemma g_eq_potential (a : σ) : (g a : PolySeries σ K) = X * dSer a (potential g) := by
  refine sub_eq_zero.mp (eq_zero_of_forall_X_pow_dvd fun N => ?_)
  exact (pow_dvd_pow X (Nat.le_succ N)).trans
    (X_pow_dvd_sub_potential g hg (fun m _ => omega_closed hI hcomm hg hc hHc m) a)

include hI hcomm hg hc hHc in
/-- **Lemma 2.20.** `I` is generated by the `H̄ₐ`. -/
theorem eq_span_barOp : I = Submodule.span (ReesWeyl σ K) (Set.range (barOp g)) := by
  refine le_antisymm ?_ (Submodule.span_le.mpr ?_)
  · rw [hI, Submodule.span_le]
    rintro _ ⟨a, rfl⟩
    have hG0 : ∀ b, coeff 0 (barOp g b : OpSeries σ K) = 0 := fun b => by
      change coeff 0 (C (dOp b) * X + PowerSeries.map mulOp.toRingHom (g b : PolySeries σ K)) = 0
      rw [map_add, coeff_C_mul, coeff_map, (hg b).1, coeff_zero_X, mul_zero, map_zero, add_zero]
    have hG1 : ∀ b, coeff 1 (barOp g b : OpSeries σ K) = dOp b := fun b => by
      change coeff 1 (C (dOp b) * X + PowerSeries.map mulOp.toRingHom (g b : PolySeries σ K)) = _
      rw [map_add, coeff_C_mul, coeff_map, (hg b).2, coeff_one_X, mul_one, map_zero, add_zero]
    obtain ⟨f, d, hfd, -⟩ := exists_poly_add (barOp g) hG0 hG1 (H a)
    have hf : polyOp f ∈ I := by
      have : polyOp f = H a - ∑ b, d b * barOp g b := by rw [hfd]; abel
      rw [this]
      refine sub_mem (hI ▸ Submodule.subset_span ⟨a, rfl⟩) (sum_mem fun b _ => ?_)
      exact Submodule.smul_mem _ _ (barOp_mem hI hHc b)
    rw [polyOp_mem_eq_zero hI hcomm hg hc hHc hf] at hfd
    have h0 : polyOp (0 : reesPoly σ K) = 0 := by
      apply Subtype.ext; simp [polyOp]
    rw [hfd, h0, zero_add]
    exact sum_mem fun b _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨b, rfl⟩)
  · rintro _ ⟨a, rfl⟩
    exact barOp_mem hI hHc a

end Main

end AiryIdeals
